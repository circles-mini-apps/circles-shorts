    "@aboutcircles/sdk-rpc": "^0.1.32",
    "@aboutcircles/sdk-transfers": "^0.1.32",
    "@aboutcircles/sdk-utils": "^0.1.32",
    "viem": "^2.50.4"
  },
  "devDependencies": {
    "@aboutcircles/sdk": "^0.1.35",
    "@aboutcircles/sdk-runner": "^0.1.35",
    "vite": "^6.4.1",
    "wrangler": "^4.93.1"
  }
