# Context7 MCP (Cursor agent docs) — get a key at https://context7.com
# export CONTEXT7_API_KEY=ctx7sk-...

# Optional: shared storage so all users see the same ideas (see supabase/schema.sql)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Circles RPC URL (must be HTTPS/public when the app is deployed — NOT localhost)
# Local dev only:
# VITE_CIRCLES_RPC_URL=http://localhost:5173/circles-rpc/
# Production example:
# VITE_CIRCLES_RPC_URL=https://rpc.aboutcircles.com/

# Local testing without CRC payments when RPC is unreachable (ideas/comments still save)
# VITE_DEMO_NO_CRC=true

# Hot reload inside the Circles host via HTTPS tunnel (hostname only, no protocol)
# 1. cloudflared tunnel --url http://localhost:5173
# 2. Copy hostname from tunnel URL, e.g. abc123.trycloudflare.com
# VITE_HMR_HOST=abc123.trycloudflare.com

# Public profile viewer URL when clicking a user name.
# {address} is replaced with the avatar address.
# Default: https://app.gnosis.io/{address}
# VITE_PROFILE_URL_TEMPLATE=https://app.gnosis.io/{address}

# Pinata IPFS pinning (https://app.pinata.cloud → API Keys → New)
# Required scope: pinJSONToIPFS. Optional: pinFileToIPFS.
# WARNING: this JWT ships to the browser; anyone visiting the app can use it.
# Use a key with a tight quota in production or proxy it through a serverless function.
# VITE_PINATA_JWT=eyJhbGciOi...

# Optional dedicated Pinata gateway (faster reads, e.g. https://crimson-fancy-snake-123.mypinata.cloud).
# Defaults to a list of public gateways.
# VITE_IPFS_GATEWAY=https://crimson-fancy-snake-123.mypinata.cloud
