# Context7 MCP (Cursor agent docs) — get a key at https://context7.com
# export CONTEXT7_API_KEY=ctx7sk-...

# Optional: shared storage so all users see the same ideas (see supabase/schema.sql)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: YouTube Data API key for embed-disabled videos (required on Cloudflare Pages).
# Create at https://console.cloud.google.com/ (enable YouTube Data API v3).
# Server (Pages Function): set YOUTUBE_API_KEY as a Cloudflare secret:
#   npx wrangler pages secret put YOUTUBE_API_KEY --project-name=circles-shorts
# Client fallback (optional, exposes key in bundle — restrict by HTTP referrer):
# VITE_YOUTUBE_API_KEY=
# YOUTUBE_API_KEY=

# Local dev only:
# VITE_CIRCLES_RPC_URL=http://localhost:5173/circles-rpc/
# Production example:
# VITE_CIRCLES_RPC_URL=https://rpc.aboutcircles.com/

# Local testing without CRC payments when RPC is unreachable (ideas/comments still save)
# VITE_DEMO_NO_CRC=true

# Hot reload inside the Circles host via HTTPS tunnel (hostname only, no protocol)
# 1. cloudflared tunnel --url http://localhost:5173
# 2. Copy hostname from tunnel URL, e.g. abc123.trycloudflare.com
# VITE_HMR_HOST=abc123.trycloudflare.com

# Public profile viewer URL when clicking a user name.
# {address} is replaced with the avatar address.
# Default: https://app.gnosis.io/{address}
# VITE_PROFILE_URL_TEMPLATE=https://app.gnosis.io/{address}

# Pinata IPFS pinning (https://app.pinata.cloud → API Keys → New)
# Production: set PINATA_JWT as a Cloudflare Pages secret (never in the client bundle):
#   npx wrangler pages secret put PINATA_JWT --project-name=circles-shorts
# Optional server env (same values as client build vars):
# CIRCLES_RPC_URL=https://rpc.aboutcircles.com/
# PLATFORM_ORG_ADDRESS=0x507F542f14F55315F96aD1D454859EaA5c9E1923
# ALLOW_DEMO_IPFS=true  # only for local dev with VITE_DEMO_NO_CRC=true
#
# Local dev: put PINATA_JWT or VITE_PINATA_JWT in .env — Vite middleware proxies /api/ipfs/*
# Do NOT set VITE_PINATA_JWT in production builds (JWT would be public in JS).
# PINATA_JWT=eyJhbGciOi...
#
# Emergency / admin scripts only (exposes JWT in browser — never deploy this way):
# VITE_IPFS_DIRECT=true
# VITE_PINATA_JWT=eyJhbGciOi...

# Optional dedicated Pinata gateway (faster reads, e.g. https://crimson-fancy-snake-123.mypinata.cloud).
# Defaults to a list of public gateways.
# VITE_IPFS_GATEWAY=https://crimson-fancy-snake-123.mypinata.cloud

# Circles organisation avatar that receives publish + flag fees (build-time).
# Register via: npm run register:org (see README)
# VITE_PLATFORM_ORG_ADDRESS=0xYourOrganisationAvatarAddress

# --- One-time org registration (npm run register:org) — NEVER commit real keys ---
# Create a dedicated Safe at https://app.safe.global (fund with ~0.01 xDAI).
# ORG_REGISTER_PRIVATE_KEY=0x...
# ORG_SAFE_ADDRESS=0x...
# ORG_NAME=Shorts
# ORG_DESCRIPTION=Platform treasury for Shorts publish and flag fees.
# ORG_AVATAR_URL=
# ORG_PREVIEW_IMAGE_URL=
# ORG_RPC_URL=https://rpc.aboutcircles.com/
